# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_test_guild_id_here_optional

# Lavalink Configuration — Multiple Nodes dengan Auto-Failover
# Bot akan otomatis switch ke node berikutnya jika salah satu error/offline.
# Semua variabel disembunyikan — hanya host/port/password yang digunakan.
#
# Node 1 (Primary/Main):
LAVALINK_HOST=your_primary_lavalink_host.com
LAVALINK_PORT=443
LAVALINK_PASSWORD=your_primary_password_here
LAVALINK_SECURE=true
LAVALINK_SELF_SIGNED=false

# Node 2 (Fallback/Backup):
LAVALINK_HOST_2=your_fallback_lavalink_host.com
LAVALINK_PORT_2=443
LAVALINK_PASSWORD_2=your_fallback_password_here
LAVALINK_SECURE_2=true
LAVALINK_SELF_SIGNED_2=false

# Node 3 (Optional Fallback):
# LAVALINK_HOST_3=another_lavalink_host.com
# LAVALINK_PORT_3=443
# LAVALINK_PASSWORD_3=another_password
# LAVALINK_SECURE_3=true
# LAVALINK_SELF_SIGNED_3=false

# Bot Settings
PREFIX=?
DEFAULT_VOLUME=80
FADE_DURATION_MS=6000
FADE_INTERVAL_MS=100

# Keep-Alive Server
PORT=3000
