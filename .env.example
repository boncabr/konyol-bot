# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_test_guild_id_here_optional

# Lavalink - Node Utama
LAVALINK_HOST=your_lavalink_host_here
LAVALINK_PORT=443
LAVALINK_PASSWORD=your_lavalink_password_here
LAVALINK_SECURE=true
# Set ke true HANYA jika host pakai self-signed certificate
LAVALINK_SELF_SIGNED=false

# Lavalink - Node Fallback (opsional)
LAVALINK_HOST_2=lavalink.serenetia.com
LAVALINK_PORT_2=443
LAVALINK_PASSWORD_2=https://dsc.gg/srnti
LAVALINK_SECURE_2=true

# Bot Settings
PREFIX=?
DEFAULT_VOLUME=80
# Batas durasi lagu dalam ms (7200000 = 2 jam). 0 = tidak ada batas
MAX_DURATION=7200000

# Keep-Alive Server
PORT=3000

# Railway Auto-Recovery (opsional)
# Isi ini agar bot otomatis redeploy saat semua node Lavalink offline
RAILWAY_TOKEN=your_railway_api_token_here
RAILWAY_SERVICE_ID=your_railway_service_id_here
RAILWAY_ENVIRONMENT_ID=your_railway_environment_id_here
